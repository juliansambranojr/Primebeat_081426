constants.Q_eps	"Z' + tail + 2w T_eps;  Z' = 2 sum_{k>=2} |Ghat(gamma_k)|^2 (double-double Gram), tail = weil_rung_min.zero_tail, T_eps = 2 Re[Ghat(g1 - i eps) conj Ghat(g1 + i eps)] = 2(|A|^2 - |B|^2)"
constants.A	"int G(u) cosh(eps u) e^{i u gamma_1} du"
constants.B	"int G(u) sinh(eps u) e^{i u gamma_1} du"
constants.weights.w=1/2	"pair {rho, conj rho} -> {rho', conj rho'}, rho' = 1/2 + eps + i gamma_1 (T_0 = pair term)"
constants.weights.w=1	"four points 1/2 +- eps +- i gamma_1 each with multiplicity one (= 2 T_eps; 2x the pair at eps = 0)"
constants.L_c	"first L in the bisected bracket with lam_min < -floor, floor = max(2 sqrt(Z'(G*)/2) bessel_rel sqrt(tr Z'/2), floor_rel * max|Q|)"
constants.basis	"legendre sqrt((2n+1)/(2h)) P_n(u/h), n = 0..M-1, on [-h, h], h = L/2"
